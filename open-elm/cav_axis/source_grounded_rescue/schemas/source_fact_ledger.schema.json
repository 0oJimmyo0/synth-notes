{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Fact Ledger",
  "type": "object",
  "required": ["case_id", "source_provenance", "facts"],
  "properties": {
    "case_id": {"type": "string"},
    "source_provenance": {"type": "object"},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "field", "value", "source_section", "supporting_text", "extraction_confidence", "manual_verification_status"],
        "properties": {
          "fact_id": {"type": "string"},
          "field": {"type": "string"},
          "value": {"type": "string"},
          "source_section": {"type": "string"},
          "supporting_text": {"type": "string"},
          "source_char_start": {"type": ["integer", "null"]},
          "source_char_end": {"type": ["integer", "null"]},
          "extraction_confidence": {"type": "number"},
          "manual_verification_status": {"enum": ["pending", "verified", "corrected", "rejected"]},
          "manual_verified_value": {"type": ["string", "null"]}
        }
      }
    }
  }
}
