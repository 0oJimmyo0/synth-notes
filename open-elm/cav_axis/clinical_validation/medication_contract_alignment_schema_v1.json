{
  "title": "Contract-bound medication evidence alignment",
  "type": "object",
  "required": ["ledger_to_note_alignment", "requires_human_review"],
  "properties": {
    "ledger_to_note_alignment": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["contract_id", "status", "note_evidence", "rationale"],
        "properties": {
          "contract_id": {"type": "string"},
          "status": {"type": "string", "enum": ["present_supported", "missing", "unsupported", "uncertain"]},
          "note_evidence": {"type": "string"},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "requires_human_review": {"type": "boolean"}
  },
  "additionalProperties": false
}
